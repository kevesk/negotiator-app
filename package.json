{
  "name": "negotiator-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "sync-vault": "bash scripts/sync-vault.sh",
    "build-index": "node scripts/build-index.mjs",
    "build-tax-data": "node scripts/build-tax-data.mjs",
    "build-prompt": "node scripts/build-prompt.mjs",
    "build-flow": "node scripts/build-flow.mjs",
    "build-all": "node scripts/build-index.mjs \"$VAULT\" && node scripts/build-prompt.mjs \"$VAULT\" && node scripts/build-flow.mjs \"$VAULT\" && node scripts/build-researcher.mjs \"$VAULT\" && node scripts/build-templates.mjs \"$VAULT\" && node scripts/build-evals.mjs \"$VAULT\"",
    "build-researcher": "node scripts/build-researcher.mjs",
    "build-templates": "node scripts/build-templates.mjs",
    "build-evals": "node scripts/build-evals.mjs",
    "evals": "vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}